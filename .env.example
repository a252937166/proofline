# App
HOST=0.0.0.0
PORT=8787
WEB_ORIGIN=http://localhost:5173
API_FOOTBALL_KEY=
FOOTBALL_DATA_TOKEN=

# Proofline defaults to an explicitly labelled sandbox so the full replay works
# without a wallet. Set these values to enable real Injective EVM testnet paths.
CHAIN_MODE=demo
# Private server-side RPC. It is never returned by /api/integrations, so a
# billable provider credential can remain server-only.
INJECTIVE_TESTNET_RPC=https://k8s.testnet.json-rpc.injective.network
INJECTIVE_TESTNET_CHAIN_ID=1439
# Explicitly public, browser-visible link. Credentials/query strings are rejected.
PUBLIC_INJECTIVE_EXPLORER_URL=https://testnet.blockscout.injective.network
PROOF_REGISTRY_ADDRESS=
# Offline testnet-only deployment admin. Keep separate from the API anchorer.
DEPLOYER_PRIVATE_KEY=
ANCHOR_PRIVATE_KEY=

X402_MODE=demo
X402_NETWORK=eip155:1439
X402_USDC_ADDRESS=0x0C382e685bbeeFE5d3d9C29e29E341fEE8E84C5d
X402_PRICE=10000
X402_PAY_TO=
X402_FACILITATOR_URL=
X402_FACILITATOR_PRIVATE_KEY=

# Dedicated testnet-only Agent payer used by `npm run buy:proof`. Never reuse a
# mainnet wallet or expose this key to the browser.
X402_AGENT_PRIVATE_KEY=
PROOFLINE_ALLOWED_PAYEE=
PROOFLINE_API_ORIGIN=http://127.0.0.1:8787
PROOFLINE_PAID_PROOF_URL=http://127.0.0.1:8787/api/matches/WC-2022-WAL-IRN/proof?eventId=final-result
PROOFLINE_SESSION_ID=proofline-testnet-judge
PROOFLINE_MAX_PROOF_USDC=0.02
PROOFLINE_MAX_SESSION_USDC=0.10

# Optional judge path: Base Sepolia -> Injective EVM testnet CCTP V2.
CCTP_SOURCE_CHAIN=base-sepolia
CCTP_SOURCE_DOMAIN=6
CCTP_DESTINATION_DOMAIN=29
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
INJECTIVE_CCTP_TOKEN_MESSENGER=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
INJECTIVE_CCTP_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
CIRCLE_IRIS_BASE_URL=https://iris-api-sandbox.circle.com

# Optional: the web app uses /api through the Vite proxy by default.
VITE_API_BASE=/api
