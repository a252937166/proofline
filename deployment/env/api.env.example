# This file is consumed by systemd, not shipped inside a release archive.
# Keep the installed copy at /opt/proofline/shared/api.env owned by root:root
# with mode 0600. Use testnet-only wallets and never commit real values.

NODE_ENV=production
HOST=127.0.0.1
PORT=4035
WEB_ORIGIN=https://proofline.axiqo.xyz
CORS_ORIGIN=https://proofline.axiqo.xyz
PUBLIC_API_URL=https://proofline.axiqo.xyz/api

API_FOOTBALL_KEY=
FOOTBALL_DATA_TOKEN=

# Safe default: the public deployment remains an honestly labelled replay.
# Change both modes only after adding funded, dedicated testnet credentials.
CHAIN_MODE=demo
INJECTIVE_TESTNET_RPC=https://k8s.testnet.json-rpc.injective.network/
INJECTIVE_TESTNET_CHAIN_ID=1439
PUBLIC_INJECTIVE_EXPLORER_URL=https://testnet.blockscout.injective.network
# Independent receipt/input indexing fallback. This is not the explorer web
# origin with /api appended; Injective publishes a separate API hostname.
PUBLIC_INJECTIVE_EXPLORER_API_URL=https://testnet.blockscout-api.injective.network/api
PROOF_REGISTRY_ADDRESS=
ANCHOR_PRIVATE_KEY=
# Required in production. Use a dedicated persistent issuer; ephemeral packet
# signers are intentionally refused for published evidence.
PROOFLINE_ISSUER_PRIVATE_KEY=

# Required to accept MCP heartbeats/execution logs in production. Persisting
# the redacted audit feed is optional but recommended.
PROOFLINE_MCP_AUDIT_TOKEN=
PROOFLINE_MCP_AUDIT_FILE=/opt/proofline/state/mcp-runtime.json

# Crash-safe single-instance replay protection for signed x402 payments.
# Pending records fail closed until an operator reconciles the chain state.
PROOFLINE_X402_LEDGER_FILE=/opt/proofline/state/x402-ledger.json

X402_MODE=demo
X402_NETWORK=eip155:1439
X402_USDC_ADDRESS=0x0C382e685bbeeFE5d3d9C29e29E341fEE8E84C5d
X402_PRICE=10000
X402_PAY_TO=
X402_FACILITATOR_URL=
X402_FACILITATOR_PRIVATE_KEY=
# Required with the inline facilitator in production. The API builds a
# loopback-only URL from PORT and this random token, forwarding only receipt
# reads to the official Injective Explorer RPC index.
X402_RPC_PROXY_TOKEN=
# Optional explicit override; normally derived from PORT + proxy token.
X402_FACILITATOR_RPC_URL=
