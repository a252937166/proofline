{
  "name": "@proofline/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "vitest run test/wallet.test.ts test/wallet-discovery.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test -c playwright.fullstack.config.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.3",
    "viem": "^2.55.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5"
  }
}
